{
  "closed": true,
  "commits": [
    {
      "author": "Dan Stupka",
      "sha": "f9ca3a315fd27d91946a15d1186e6e209e4e76fb",
      "subject": "Canonicalize HTH persistence architecture across pipelines"
    },
    {
      "author": "Dan Stupka",
      "sha": "17bce530fb01112bdf5a971e6e43954d83b7e4fc",
      "subject": "Fix optimizer preferred-configuration observation counts so the report reflects all compatible persisted measurements contributing to each runner/workload profile, rather than only the observation count attached to the winning shape. This makes the table agree with the coalesced profile and shape evidence while preserving strict workload compatibility boundaries; repeated measurements of the same shape and measurements of different shapes are both counted. Add a regression test covering multi-run, repeated-shape coalescing. All 639 unittest tests pass."
    },
    {
      "author": "Dan Stupka",
      "sha": "b9965ed05a8e2dd32e6ee666099d4e724453e0ac",
      "subject": "Align the published optimizer plot with the current execution"
    },
    {
      "author": "Dan Stupka",
      "sha": "45e8d4330fa653d0c00ab97517ae6628f0363c33",
      "subject": "Preserve execution-optimizer history as durable per-run evidence. Completed runs now write run metadata, shape observations, shard observations, and runner metrics under `execution-optimizer/<detector>/runs/<run-id>/`; optimizer/report regeneration rehydrates from those records instead of treating derived indexes as sole history. This prevents future index rebuilds or migrations from collapsing multiple optimizer runs to one, while retaining legacy published-summary recovery for history that predates the new contract. All 637 `unittest` tests pass."
    },
    {
      "author": "Dan Stupka",
      "sha": "b7d420aaa4aef2f01c6f90b41bd7436058b1542d",
      "subject": "Recover optimizer reports directly from published summaries"
    },
    {
      "author": "Dan Stupka",
      "sha": "ac0f6d40e3d14a14ca393654aed36e2e3b2c1d14",
      "subject": "Recover optimizer reports when the derived optimizer index is absent"
    },
    {
      "author": "Dan Stupka",
      "sha": "5b05f4275832528623c4571f736f87a5d802e8d0",
      "subject": "Use recovered calibration history in regression reports"
    },
    {
      "author": "Dan Stupka",
      "sha": "0ea069af28b968ac63996322b5d3a923f1a00105",
      "subject": "Recover authoritative calibration history from persisted evidence"
    },
    {
      "author": "Dan Stupka",
      "sha": "45ba609fda10690767cc9369eeda959491a2547a",
      "subject": "Fix results-index path resolution after moving indexes into indexes/. Persisted calibration paths are repository-relative, but several readers were resolving them relative to the index file itself, producing indexes/source-documents/... and silently hiding historical calibration evidence. Centralize canonical/legacy index root resolution and use it for Best Known calibration loading, Known Builds parameter provenance, best-parameter resolution, and runtime history. This restores authoritative full calibrations and historical build visibility without changing the persisted index format, while retaining legacy root-index compatibility. Add a regression test proving Known Builds works from the canonical indexes/calibration-index.json location; the full unittest suite passes with 631 tests."
    },
    {
      "author": "Dan Stupka",
      "sha": "5aef7fd387c23dd15a4c3ec67584d6172f23def3",
      "subject": "Preserve legacy calibration-index reads during the indexes/ migration."
    },
    {
      "author": "Dan Stupka",
      "sha": "11db785ea57b83f44e386701f970994297fde612",
      "subject": "Move persistent results indexes under indexes/ and align the results-repo documentation layout."
    },
    {
      "author": "Dan Stupka",
      "sha": "e89bd2a6c0d93e77e5de67360dfeb0e43de3db46",
      "subject": "Update source repo link; the initial reference collection"
    },
    {
      "author": "Dan Stupka",
      "sha": "ddf9c75df6d001df32d539f6aee8ad84ae016823",
      "subject": "Remove the framework-local source placeholder"
    }
  ],
